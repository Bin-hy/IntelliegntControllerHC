QWidget {
    background-color: #1C2541;
    color: #B0C4DE;
    font-family: "Segoe UI", "Roboto", "Helvetica", sans-serif;
    font-size: 14px;
}

QGroupBox {
    border: 1px solid rgba(0, 191, 255, 0.7);
    border-radius: 8px;
    margin-top: 18px;
    background-color: rgba(0, 191, 255, 0.06);
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 4px 14px;
    color: #00BFFF;
    font-weight: 600;
    background-color: #1C2541;
    border: 1px solid rgba(0, 191, 255, 0.85);
    border-radius: 12px;
}

QPushButton {
    background-color: rgba(0, 191, 255, 0.12);
    border: 1px solid rgba(0, 191, 255, 0.85);
    color: #00BFFF;
    padding: 8px 18px;
    border-radius: 8px;
    font-size: 14px;
}
QPushButton:hover {
    background-color: rgba(0, 191, 255, 0.25);
    border: 1px solid rgba(127, 217, 255, 0.9);
    color: #E6F7FF;
}
QPushButton:pressed {
    background-color: rgba(0, 191, 255, 0.35);
}
QPushButton:disabled {
    border-color: rgba(176, 196, 222, 0.35);
    color: rgba(176, 196, 222, 0.45);
    background-color: rgba(28, 37, 65, 0.7);
}

QPushButton#btn_power_on,
QPushButton#btn_power_off {
    background-color: rgba(0, 191, 255, 0.16);
    border-color: rgba(0, 191, 255, 0.95);
    color: #00BFFF;
}
QPushButton#btn_power_on:hover,
QPushButton#btn_power_off:hover {
    background-color: rgba(0, 191, 255, 0.32);
    color: #E6F7FF;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QListWidget {
    background-color: #141B33;
    border: 1px solid rgba(176, 196, 222, 0.3);
    border-radius: 6px;
    padding: 6px 8px;
    color: #B0C4DE;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QListWidget:focus {
    border: 1px solid #00BFFF;
    background-color: #11182E;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left-width: 1px;
    border-left-color: rgba(176, 196, 222, 0.3);
    border-left-style: solid;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #00BFFF;
    margin-top: 1px;
}
QComboBox QAbstractItemView {
    background: #141B33;
    border: 1px solid rgba(0, 191, 255, 0.8);
    selection-background-color: rgba(0, 191, 255, 0.35);
    selection-color: #E6F7FF;
}

QTabWidget::pane {
    border: 1px solid rgba(176, 196, 222, 0.25);
    background: #1C2541;
    top: -1px;
}
QTabBar::tab {
    background: #182037;
    color: #B0C4DE;
    padding: 10px 24px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
    background: rgba(0, 191, 255, 0.14);
    color: #00BFFF;
    font-weight: 600;
    border-bottom: 2px solid #00BFFF;
}
QTabBar::tab:hover {
    background: rgba(0, 191, 255, 0.12);
    color: #E6F7FF;
}

QTextEdit {
    background-color: #0F162B;
    border: 1px solid rgba(176, 196, 222, 0.3);
    color: #B0C4DE;
    border-radius: 6px;
    padding: 6px 8px;
    font-family: "Consolas", "Monospace";
}

QCheckBox {
    spacing: 8px;
    color: #B0C4DE;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid rgba(0, 191, 255, 0.85);
    background-color: #141B33;
}
QCheckBox::indicator:checked {
    background-color: #00BFFF;
    border: 1px solid rgba(127, 217, 255, 0.95);
}
QCheckBox::indicator:disabled {
    border-color: rgba(176, 196, 222, 0.35);
    background-color: rgba(28, 37, 65, 0.8);
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    border: none;
    background: #1C2541;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: rgba(176, 196, 222, 0.35);
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(0, 191, 255, 0.8);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    border: none;
    background: #1C2541;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: rgba(176, 196, 222, 0.35);
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(0, 191, 255, 0.8);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QLabel {
    color: #B0C4DE;
}
QLabel#header {
    font-size: 18px;
    font-weight: 600;
    color: #00BFFF;
}

QLabel#video_label {
    border: 1px dashed rgba(176, 196, 222, 0.4);
    background-color: #0B1024;
    color: rgba(176, 196, 222, 0.6);
    font-size: 16px;
    border-radius: 6px;
}
