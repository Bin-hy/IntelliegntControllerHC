# Request: detect/locate object at user-selected pixel or auto-detect
string camera_ns
float64 select_u    # user-selected pixel x (-1 = auto-detect with YOLO)
float64 select_v    # user-selected pixel y (-1 = auto-detect with YOLO)
---
# Response: detection result with 3D position in camera frame
bool success
string message
float64 u
float64 v
float64 confidence
float64 x
float64 y
float64 z
float64 bbox_width
float64 bbox_height
