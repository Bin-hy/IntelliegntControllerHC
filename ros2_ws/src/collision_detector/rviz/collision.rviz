Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    # ---- TF 坐标系 ----
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: true
      Frame Timeout: 5
      Frames:
        All Enabled: false
        base_link: {Value: true}
        link_1: {Value: true}
        link_2: {Value: true}
        link_3: {Value: true}
        link_4: {Value: true}
        link_5: {Value: true}
        link_6: {Value: true}

    # ---- 机器人模型 ----
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Alpha: 0.5

    # ---- 原始点云 ----
    - Class: rviz_default_plugins/PointCloud2
      Name: PointCloud2
      Enabled: true
      Topic:
        Value: /camera/depth/points
        Reliability: Best Effort
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Alpha: 0.3
      Decay Time: 0

    # ---- 碰撞检测标记 ----
    - Class: rviz_default_plugins/MarkerArray
      Name: CollisionMarkers
      Enabled: true
      Topic:
        Value: /collision_detector/markers

  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.6
      Yaw: 3.14
      Name: Current View
